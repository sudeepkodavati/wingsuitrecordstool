{
  "name": "wingsuit-records",
  "version": "0.1.0",
  "private": true,
  "description": "Wingsuit Skydiving Records tool — event and skydiver pool management for organizers and judges",
  "workspaces": [
    "client"
  ],
  "scripts": {
    "dev": "npm run dev -w client",
    "build": "npm run build -w client",
    "preview": "npm run preview -w client",
    "test": "npm test -w client",
    "typecheck": "npm run typecheck -w client",
    "test:db": "npm run test:db -w client",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "dev:localdb": "npm run dev:localdb -w client",
    "test:api": "node --test scripts/*.test.mjs"
  },
  "engines": {
    "node": "22.x"
  },
  "devDependencies": {
    "supabase": "^2.120.0"
  }
}
